FROM node:25.2-alpine3.22 AS builder
RUN apk add --update --no-cache \
    python3 \
    pkgconfig \
    make \
    g++ \
    pixman \
    jpeg-dev \
    cairo-dev \
    giflib-dev \
    pango-dev \
    libtool
WORKDIR /cosmae
COPY ui/package*.json ./
COPY ui/tsconfig.json ./
COPY ui/babel.config.cjs ./
RUN npm ci --omit=dev
ADD ui/index.html /cosmae/
ADD ui/vite.config.js /cosmae/
ADD ui/tsconfig.app.json /cosmae/
ADD ui/tsconfig.node.json /cosmae/
ADD ui/src/ /cosmae/src
ADD ui/public /cosmae/public
ADD ui/openapi.js /cosmae/openapi.js
ADD ui/openapi /cosmae/openapi
RUN cp /cosmae/src/config_production.ts /cosmae/src/config.ts
# Needed to ensure network connectivity for some reason
RUN npm config set fetch-timeout 120000 && npm config set fetch-retries 5
RUN npm install vite @vitejs/plugin-react
RUN npm run openapi
RUN npm run build

FROM nginx:1.29.0-alpine
COPY --from=builder /cosmae/build /srv/cosmae
COPY container/resources/robots.txt /srv/cosmae
COPY container/resources/nginx.conf /etc/nginx
