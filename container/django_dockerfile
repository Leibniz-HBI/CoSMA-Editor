FROM python:3.14-slim-trixie
ARG USER_ID
ARG GROUP_ID
RUN apt-get update && apt-get install -y  gcc g++ libpq-dev whois postgresql-client-17

ARG POETRY_VIRTUALENVS_CREATE=false
RUN pip install --upgrade pip poetry --no-cache-dir && \
	pip install uvicorn gunicorn "psycopg[c]==3.3.2" --no-cache-dir
WORKDIR /cosmae
COPY pyproject.toml poetry.lock /cosmae/
RUN poetry install --without=dev --no-root
ADD cosmae /cosmae/cosmae
ADD django_project /cosmae/django_project
COPY manage.py /cosmae/
# RUN apk --purge del .build-deps
RUN mkdir -p /var/www
RUN chown -R ${USER_ID}:${GROUP_ID} /var/www
CMD sh -c ' python3 manage.py migrate && python manage.py collectstatic --no-input && gunicorn django_project.asgi:application -k uvicorn.workers.UvicornWorker -b 0.0.0.0:8000'
